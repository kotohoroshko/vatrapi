APP_NAME=vatrapi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Public git URL for AGPL Corresponding Source (shown on GET /source and in JSON-LD).
# GET /source/archive still offers the running tree even if this is empty.
APP_SOURCE_URL=https://github.com/kotohoroshko/vatrapi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# No SQL database and no Redis. File/array/sync drivers only.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null

CACHE_STORE=file

# API access (app/Module/ApiAccess). Keys are "name:plan:secret", comma-separated;
# plans and their limits live in app/Module/ApiAccess/config/api-access.php.
# Counters use the cache store above. Empty anonymous limit = unlimited, 0 = blocked.
API_KEY_HEADER=X-API-Key
API_KEYS=
API_ANONYMOUS_PER_MINUTE=
API_ANONYMOUS_PER_MONTH=

# Landing playground. The server adds this key when forwarding playground runs,
# so it never reaches the browser. Also list it in API_KEYS on the service plan:
#   API_KEYS="playground:service:<same secret>"
# PLAYGROUND_PER_MINUTE throttles the playground route per IP (empty = off).
PLAYGROUND_API_KEY=
PLAYGROUND_PER_MINUTE=30

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@vatrapi.test"
MAIL_FROM_NAME="${APP_NAME}"

# Docker port forwarding (host machine)
APP_PORT=8080

# Native (non-Docker) Swiss Ephemeris data path. `php artisan swephp:install` sets this.
# SWISS_EPHEMERIS_EPHE_PATH=

# Host user mapping for Docker build (Linux/macOS)
UID=1000
GID=1000

# MCP memory is stored in .mcp/memory.jsonl (configured by Docker/scripts/mcp-memory.sh)
