<?php

/**
 * PHPStan stub for the swephp extension.
 *
 * The extension declares its float parameters with the pseudo-type `double`,
 * which PHP reflection reports literally as "double" and PHPStan then treats as
 * an unknown type — producing false "expects double, float given" errors.
 * These stubs redeclare the functions this module uses with accurate `float`
 * types so static analysis reflects real (runtime-coerced) behaviour.
 */

